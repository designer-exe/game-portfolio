# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# Firebase Configuration (Realtime Music Suggestions & Admin)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
# Formspree Configuration (Contact Form Email Integration)
# Replace with your actual Formspree form endpoint from https://formspree.io/
# Example: VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/your_form_id
VITE_FORMSPREE_ENDPOINT=
